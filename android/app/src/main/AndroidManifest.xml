<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Lets ARCore read motion sensors above 200 Hz on Android 12+. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Send to nearby phone: find other RoomScape phones on the Wi-Fi (NSD needs multicast). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- ARCore below is required; do not implicitly require the legacy rear-camera/autofocus feature. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Keep processing a finished scan while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="true" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application android:label="RoomScape" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/RoomScape">
        <meta-data android:name="com.google.ar.core" android:value="required" />
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="subject_segment" />
        <!-- EXPERIMENT: ultrawide recorder without ARCore (remove with the experiment/ folder) -->
        <activity android:name=".experiment.UltrawideRecorderActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open .rmsc room files from Files, chats or the browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.roomscape.rmsc+zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.roomscape.rmsc+zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- Make photo-real: Brush trains in its own process, so the scanner's memory isn't held meanwhile. -->
        <activity android:name=".PhotoRealActivity" android:exported="false" android:process=":photoreal"
            android:screenOrientation="portrait" android:configChanges="orientation|screenSize|keyboardHidden" />
        <service android:name=".ProcessingService" android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
