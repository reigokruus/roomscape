+/// RoomScape change (13 Nov 2026): on iOS a refine only runs if the app has room for it. iOS stops an app that crosses
+/// its memory limit (about 3.4 GB on an iPhone 15 Pro, everything included), and a refine briefly needs about 2 GB on
+/// top of training (measured on the phone: 818 -> 2,847 MB at step 200, 1,411 -> 3,056 MB at step 600). So before each
+/// refine unused memory is given back, and the refine runs only with at least 2.25 GB available (the 2.0 GB spike plus
+/// 0.25 GB to spare); otherwise it is skipped (training goes on with the splats it has) and noted in refine-skips.txt
+/// next to the export ("step availableMB footprintMB"), which the app reports. Always true elsewhere.
+/// Two stages (13 Nov, measured with marks on the phone: only the first two refines of a run burst, by about 1.6 GB
+/// for 0.8-3 s, when GPU work first meets the new splat counts; later ones need about 60 MB): until two refines have
+/// run, BRUSH_REFINE_MIN_AVAIL_MB (default 1700) must be available, after that BRUSH_REFINE_MIN_AVAIL_LATER_MB
+/// (default 800).
+// RoomScape change (13 Nov 2026): also on Android (the S24), with MemAvailable as the measure.
+#[cfg(any(target_os = "ios", target_os = "android"))]
+fn refine_headroom_ok(device: &crate::ProcessDevice, iter: u32, export_path: &Path) -> bool {
+    let env_mb = |name: &str, default: u64| std::env::var(name).ok().and_then(|v| v.trim().parse().ok()).unwrap_or(default);
+    let early = REFINES_RUN.load(std::sync::atomic::Ordering::Relaxed) < 2;
+    let needed: u64 = if early { env_mb("BRUSH_REFINE_MIN_AVAIL_MB", 1700) } else { env_mb("BRUSH_REFINE_MIN_AVAIL_LATER_MB", 800) } << 20;
+    device.memory_cleanup();
+    let avail = brush_train::memmarks::available();
+    if avail >= needed {
+        return true;
+    }
+    use std::io::Write;
+    let _ = std::fs::create_dir_all(export_path);
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(export_path.join("refine-skips.txt")) {
+        let _ = writeln!(f, "{iter} {} {}", avail >> 20, brush_train::memmarks::footprint() >> 20);
+    }
+    false
+}
+
+/// Refines that ran in this process's current training (reset when a training starts).
+static REFINES_RUN: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+#[cfg(not(any(target_os = "ios", target_os = "android")))]
+fn refine_headroom_ok(_device: &crate::ProcessDevice, _iter: u32, _export_path: &Path) -> bool {
+    true
+}
