diff --git a/crates/brush-process/src/lib.rs b/crates/brush-process/src/lib.rs
index 2cac2366..1a359310 100644
--- a/crates/brush-process/src/lib.rs
+++ b/crates/brush-process/src/lib.rs
@@ -28,9 +28,60 @@ use brush_vfs::SendNotWasm;
 use tokio_stream::{Stream, StreamExt};
 
 fn burn_options() -> RuntimeOptions {
+    cubecl_config();
     RuntimeOptions {
         tasks_max: 64,
-        memory_config: burn_wgpu::MemoryConfiguration::ExclusivePages,
+        memory_config: memory_config(),
+    }
+}
+
+/// RoomScape change (12 Nov 2026): on iOS an app gets about 3.4 GB in all, and with `ExclusivePages` (one page per
+/// allocation in exponentially spaced size buckets, kept for reuse) the refine steps' big temporaries pushed the
+/// footprint about 2 GB over its 1 GB baseline, to 3.0 GB, and iOS stopped the app. A `Direct` pool allocates exact
+/// sizes and gives free memory back to the driver once more than `RECLAIM_AT` is reserved. Elsewhere unchanged unless
+/// `BRUSH_DIRECT_POOL=1` (to measure the difference on a Mac).
+fn memory_config() -> burn_wgpu::MemoryConfiguration {
+    // 512 MiB (was 1 GiB, 12 Nov 21:59): the first refines after loading still reached 2.4 GB of the phone's 3.4 GB
+    const RECLAIM_AT: u64 = 512 << 20;
+    let direct = cfg!(any(target_os = "ios", target_os = "android")) ||   // RoomScape change: Android too
+        std::env::var("BRUSH_DIRECT_POOL").is_ok_and(|v| v == "1");
+    if direct {
+        burn_wgpu::MemoryConfiguration::Custom {
+            pool_options: vec![burn::cubecl::MemoryPoolOptions {
+                pool_type: burn::cubecl::PoolType::Direct { reclaim_at: Some(RECLAIM_AT) },
+                dealloc_period: None,
+            }],
+        }
+    } else {
+        burn_wgpu::MemoryConfiguration::ExclusivePages
+    }
+}
+
+/// RoomScape change (13 Nov 2026): CubeCL reads its settings (cubecl.toml, CUBECL_* env vars) only where its `std_io`
+/// cfg is on, which in this vendored version is Windows, Linux, macOS and Android, not iOS (cubecl-runtime build.rs,
+/// `RuntimeConfig::get`). So on the phone CUBECL_AUTOTUNE_LEVEL, which the app sets, never applied. Here, before the
+/// device exists, the same settings are installed from code on iOS: the autotune level from CUBECL_AUTOTUNE_LEVEL, and
+/// with BRUSH_AUTOTUNE_LOG=1 CubeCL's autotune log on stderr (the app's memory test sends stderr to a file), to see
+/// whether the ~2 GB bursts at the first steps and the first refines are autotune benchmarks.
+fn cubecl_config() {
+    #[cfg(target_os = "ios")]
+    {
+        use burn::cubecl::config::autotune::{AutotuneLevel, AutotuneLogLevel};
+        use burn::cubecl::config::{CubeClRuntimeConfig, RuntimeConfig};
+        let mut cfg = CubeClRuntimeConfig::default();
+        match std::env::var("CUBECL_AUTOTUNE_LEVEL").as_deref() {
+            Ok("minimal" | "0") => cfg.autotune.level = AutotuneLevel::Minimal,
+            Ok("balanced" | "1") => cfg.autotune.level = AutotuneLevel::Balanced,
+            Ok("extensive" | "2") => cfg.autotune.level = AutotuneLevel::Extensive,
+            Ok("full" | "3") => cfg.autotune.level = AutotuneLevel::Full,
+            _ => {}
+        }
+        if std::env::var("BRUSH_AUTOTUNE_LOG").is_ok_and(|v| v == "1") {
+            cfg.autotune.logger.stderr = true;
+            cfg.autotune.logger.level = AutotuneLogLevel::Minimal;
+        }
+        // false when CubeCL's settings were already read (a second training in the same app run): they stay
+        let _ = CubeClRuntimeConfig::try_set(cfg);
     }
 }
 
