+//! RoomScape change (13 Nov 2026): memory marks on iOS, to find what takes the phone's memory about 2 GB up at the
+//! start of training and at every refine (measured from the app, but not which part of Brush).
+//!
+//! `mark(file, step, name)` ... `.end()` writes one JSON line {step, name, before_mb, after_mb, peak_mb, avail_mb, ms}
+//! to `<dir>/<file>.jsonl`. A background thread samples the process footprint every 20 ms, so a peak that lasts well
+//! under a second between `mark` and `end` is caught. Lines are kept in memory until `set_dir` says where to write.
+//! Everywhere but iOS every call is a no-op.
+
+#[cfg(any(target_os = "ios", target_os = "android"))]   // RoomScape change: Android too (13 Nov 2026)
+mod imp {
+    use std::io::Write;
+    use std::path::PathBuf;
+    use std::sync::Mutex;
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+    use std::time::Instant;
+
+    static DIR: Mutex<Option<PathBuf>> = Mutex::new(None);
+    static PENDING: Mutex<Vec<(&'static str, String)>> = Mutex::new(Vec::new());
+    static PEAK: AtomicU64 = AtomicU64::new(0);
+    static SAMPLING: AtomicBool = AtomicBool::new(false);
+
+    #[cfg(target_os = "ios")]
+    unsafe extern "C" {
+        static mach_task_self_: u32;
+        fn task_info(target: u32, flavor: i32, info: *mut i32, count: *mut u32) -> i32;
+        fn os_proc_available_memory() -> usize;
+    }
+
+    /// The process footprint in bytes (task_vm_info.phys_footprint: what iOS's memory limit counts).
+    #[cfg(target_os = "ios")]
+    pub fn footprint() -> u64 {
+        let mut buf = [0i32; 128];
+        let mut count: u32 = 128;
+        // SAFETY: TASK_VM_INFO (22) fills at most `count` 32-bit words into `buf`; phys_footprint sits at byte 144
+        // (checked against the SDK's task_vm_info_data_t).
+        unsafe {
+            if task_info(mach_task_self_, 22, buf.as_mut_ptr(), &mut count) != 0 {
+                return 0;
+            }
+            std::ptr::read_unaligned((buf.as_ptr() as *const u8).add(144) as *const u64)
+        }
+    }
+
+    #[cfg(target_os = "ios")]
+    pub fn available() -> u64 {
+        // SAFETY: a plain libSystem query (iOS 13+).
+        unsafe { os_proc_available_memory() as u64 }
+    }
+
+    /// Android: the process's resident memory (/proc/self/statm, pages); GPU memory is shared with the system there.
+    #[cfg(target_os = "android")]
+    pub fn footprint() -> u64 {
+        std::fs::read_to_string("/proc/self/statm")
+            .ok()
+            .and_then(|s| s.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()))
+            .map_or(0, |pages| pages * 4096)
+    }
+
+    /// Android: the system's MemAvailable (/proc/meminfo): what the low-memory killer watches.
+    #[cfg(target_os = "android")]
+    pub fn available() -> u64 {
+        std::fs::read_to_string("/proc/meminfo")
+            .ok()
+            .and_then(|s| {
+                s.lines()
+                    .find(|l| l.starts_with("MemAvailable:"))
+                    .and_then(|l| l.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()))
+            })
+            .map_or(u64::MAX, |kb| kb * 1024)
+    }
+
+    fn start_sampler() {
+        if SAMPLING.swap(true, Ordering::SeqCst) {
+            return;
+        }
+        std::thread::Builder::new()
+            .name("memmarks".into())
+            .spawn(|| {
+                loop {
+                    PEAK.fetch_max(footprint(), Ordering::Relaxed);
+                    std::thread::sleep(std::time::Duration::from_millis(20));
+                }
+            })
+            .ok();
+    }
+
+    pub fn set_dir(dir: &std::path::Path) {
+        let _ = std::fs::create_dir_all(dir);
+        *DIR.lock().unwrap() = Some(dir.to_path_buf());
+        let pending: Vec<_> = std::mem::take(&mut *PENDING.lock().unwrap());
+        for (file, line) in pending {
+            write(file, &line);
+        }
+    }
+
+    fn write(file: &'static str, line: &str) {
+        let dir = DIR.lock().unwrap().clone();
+        let Some(dir) = dir else {
+            PENDING.lock().unwrap().push((file, line.to_owned()));
+            return;
+        };
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(dir.join(format!("{file}.jsonl"))) {
+            let _ = writeln!(f, "{line}");
+        }
+    }
+
+    pub struct Mark {
+        file: &'static str,
+        step: u32,
+        name: &'static str,
+        before: u64,
+        start: Instant,
+    }
+
+    /// Starts a mark and writes a "begin" line straight away (each line goes to the file as it is written, so if
+    /// iOS stops the app in the middle, the last begin line names the part that was running).
+    pub fn mark(file: &'static str, step: u32, name: &'static str) -> Mark {
+        let m = quiet(file, step, name);
+        write(
+            file,
+            &format!("{{\"step\":{step},\"name\":\"{name}\",\"begin\":true,\"before_mb\":{},\"avail_mb\":{}}}", m.before >> 20, available() >> 20),
+        );
+        m
+    }
+
+    /// A mark without the begin line (for one around every training step, written only when it jumped).
+    pub fn quiet(file: &'static str, step: u32, name: &'static str) -> Mark {
+        start_sampler();
+        let before = footprint();
+        PEAK.store(before, Ordering::Relaxed);
+        Mark { file, step, name, before, start: Instant::now() }
+    }
+
+    impl Mark {
+        pub fn end(self) {
+            self.end_with(&[]);
+        }
+
+        /// Ends the mark only if the footprint's peak went at least `jump_mb` above where it started.
+        pub fn end_if_jump(self, jump_mb: u64, extra: &[(&str, u64)]) {
+            let peak = PEAK.load(Ordering::Relaxed).max(footprint());
+            if peak >= self.before + (jump_mb << 20) {
+                self.end_with(extra);
+            }
+        }
+
+        /// Ends the mark with extra numbers in the line (e.g. the forward render's intersection count).
+        pub fn end_with(self, extra: &[(&str, u64)]) {
+            let after = footprint();
+            let peak = PEAK.load(Ordering::Relaxed).max(after);
+            let mb = |b: u64| b >> 20;
+            let mut more = String::new();
+            for (k, v) in extra {
+                more.push_str(&format!(",\"{k}\":{v}"));
+            }
+            write(
+                self.file,
+                &format!(
+                    "{{\"step\":{},\"name\":\"{}\",\"before_mb\":{},\"after_mb\":{},\"peak_mb\":{},\"avail_mb\":{},\"ms\":{}{more}}}",
+                    self.step,
+                    self.name,
+                    mb(self.before),
+                    mb(after),
+                    mb(peak),
+                    mb(available()),
+                    self.start.elapsed().as_millis()
+                ),
+            );
+        }
+    }
+}
+
+#[cfg(not(any(target_os = "ios", target_os = "android")))]
+mod imp {
+    pub struct Mark;
+    pub fn mark(_file: &'static str, _step: u32, _name: &'static str) -> Mark {
+        Mark
+    }
+    pub fn quiet(_file: &'static str, _step: u32, _name: &'static str) -> Mark {
+        Mark
+    }
+    impl Mark {
+        pub fn end(self) {}
+        pub fn end_if_jump(self, _jump_mb: u64, _extra: &[(&str, u64)]) {}
+        pub fn end_with(self, _extra: &[(&str, u64)]) {}
+    }
+    pub fn set_dir(_dir: &std::path::Path) {}
+    pub fn footprint() -> u64 {
+        0
+    }
+    pub fn available() -> u64 {
+        u64::MAX
+    }
+}
+
+pub use imp::{Mark, available, footprint, mark, quiet, set_dir};
