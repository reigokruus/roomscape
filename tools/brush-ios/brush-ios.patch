diff --git a/crates/brush-train/src/memmarks.rs b/crates/brush-train/src/memmarks.rs
new file mode 100644
index 00000000..25406108
--- /dev/null
+++ b/crates/brush-train/src/memmarks.rs
@@ -0,0 +1,137 @@
+//! RoomScape change (13 Nov 2026): memory marks on iOS, to find what takes the phone's memory about 2 GB up at the
+//! start of training and at every refine (measured from the app, but not which part of Brush).
+//!
+//! `mark(file, step, name)` ... `.end()` writes one JSON line {step, name, before_mb, after_mb, peak_mb, avail_mb, ms}
+//! to `<dir>/<file>.jsonl`. A background thread samples the process footprint every 20 ms, so a peak that lasts well
+//! under a second between `mark` and `end` is caught. Lines are kept in memory until `set_dir` says where to write.
+//! Everywhere but iOS every call is a no-op.
+
+#[cfg(target_os = "ios")]
+mod imp {
+    use std::io::Write;
+    use std::path::PathBuf;
+    use std::sync::Mutex;
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+    use std::time::Instant;
+
+    static DIR: Mutex<Option<PathBuf>> = Mutex::new(None);
+    static PENDING: Mutex<Vec<(&'static str, String)>> = Mutex::new(Vec::new());
+    static PEAK: AtomicU64 = AtomicU64::new(0);
+    static SAMPLING: AtomicBool = AtomicBool::new(false);
+
+    unsafe extern "C" {
+        static mach_task_self_: u32;
+        fn task_info(target: u32, flavor: i32, info: *mut i32, count: *mut u32) -> i32;
+        fn os_proc_available_memory() -> usize;
+    }
+
+    /// The process footprint in bytes (task_vm_info.phys_footprint: what iOS's memory limit counts).
+    pub fn footprint() -> u64 {
+        let mut buf = [0i32; 128];
+        let mut count: u32 = 128;
+        // SAFETY: TASK_VM_INFO (22) fills at most `count` 32-bit words into `buf`; phys_footprint sits at byte 144
+        // (checked against the SDK's task_vm_info_data_t).
+        unsafe {
+            if task_info(mach_task_self_, 22, buf.as_mut_ptr(), &mut count) != 0 {
+                return 0;
+            }
+            std::ptr::read_unaligned((buf.as_ptr() as *const u8).add(144) as *const u64)
+        }
+    }
+
+    pub fn available() -> u64 {
+        // SAFETY: a plain libSystem query (iOS 13+).
+        unsafe { os_proc_available_memory() as u64 }
+    }
+
+    fn start_sampler() {
+        if SAMPLING.swap(true, Ordering::SeqCst) {
+            return;
+        }
+        std::thread::Builder::new()
+            .name("memmarks".into())
+            .spawn(|| {
+                loop {
+                    PEAK.fetch_max(footprint(), Ordering::Relaxed);
+                    std::thread::sleep(std::time::Duration::from_millis(20));
+                }
+            })
+            .ok();
+    }
+
+    pub fn set_dir(dir: &std::path::Path) {
+        let _ = std::fs::create_dir_all(dir);
+        *DIR.lock().unwrap() = Some(dir.to_path_buf());
+        let pending: Vec<_> = std::mem::take(&mut *PENDING.lock().unwrap());
+        for (file, line) in pending {
+            write(file, &line);
+        }
+    }
+
+    fn write(file: &'static str, line: &str) {
+        let dir = DIR.lock().unwrap().clone();
+        let Some(dir) = dir else {
+            PENDING.lock().unwrap().push((file, line.to_owned()));
+            return;
+        };
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(dir.join(format!("{file}.jsonl"))) {
+            let _ = writeln!(f, "{line}");
+        }
+    }
+
+    pub struct Mark {
+        file: &'static str,
+        step: u32,
+        name: &'static str,
+        before: u64,
+        start: Instant,
+    }
+
+    pub fn mark(file: &'static str, step: u32, name: &'static str) -> Mark {
+        start_sampler();
+        let before = footprint();
+        PEAK.store(before, Ordering::Relaxed);
+        Mark { file, step, name, before, start: Instant::now() }
+    }
+
+    impl Mark {
+        pub fn end(self) {
+            let after = footprint();
+            let peak = PEAK.load(Ordering::Relaxed).max(after);
+            let mb = |b: u64| b >> 20;
+            write(
+                self.file,
+                &format!(
+                    "{{\"step\":{},\"name\":\"{}\",\"before_mb\":{},\"after_mb\":{},\"peak_mb\":{},\"avail_mb\":{},\"ms\":{}}}",
+                    self.step,
+                    self.name,
+                    mb(self.before),
+                    mb(after),
+                    mb(peak),
+                    mb(available()),
+                    self.start.elapsed().as_millis()
+                ),
+            );
+        }
+    }
+}
+
+#[cfg(not(target_os = "ios"))]
+mod imp {
+    pub struct Mark;
+    pub fn mark(_file: &'static str, _step: u32, _name: &'static str) -> Mark {
+        Mark
+    }
+    impl Mark {
+        pub fn end(self) {}
+    }
+    pub fn set_dir(_dir: &std::path::Path) {}
+    pub fn footprint() -> u64 {
+        0
+    }
+    pub fn available() -> u64 {
+        u64::MAX
+    }
+}
+
+pub use imp::{Mark, available, footprint, mark, set_dir};
